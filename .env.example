# Copy this file to .env and replace every value marked CHANGE_ME.
# Never commit the .env file.
DATABASE_URL=postgresql+psycopg://vacation_user:CHANGE_ME@localhost:5432/vacation_together
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
FRONTEND_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=30
POSTGRES_DB=vacation_together
POSTGRES_USER=vacation_user
POSTGRES_PASSWORD=...
